# Copy this file to .env and fill in the values before starting the stack.
# .env is listed in .gitignore and must never be committed.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=finaro
POSTGRES_USER=finaro
POSTGRES_PASSWORD=change_me_in_production

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/finaro
SPRING_DATASOURCE_USERNAME=finaro
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_random_256_bit_hex_string
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=2592000

# ── AI (OpenAI-compatible endpoint) ──────────────────────────────────────────
SPRING_AI_OPENAI_API_KEY=sk-...
# Optional: override base URL for self-hosted or compatible endpoints
# SPRING_AI_OPENAI_BASE_URL=https://api.openai.com

# ── Application profile ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
