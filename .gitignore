# ── Environment & secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
# Local overrides (never commit — may contain real credentials)
.env.local
.env.*.local

# ── Java / Maven ───────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven wrapper jar (downloaded on demand)
.mvn/wrapper/maven-wrapper.jar

# ── Node / Angular ─────────────────────────────────────────────────────────────
node_modules/
dist/
.angular/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs ───────────────────────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
# Ignore all VS Code user settings, but keep shared project config
.vscode/*
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Spring Tool Suite / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
build/

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test output ────────────────────────────────────────────────────────────────
coverage/

# ── JVM crash dumps ────────────────────────────────────────────────────────────
hs_err_pid*.log
replay_pid*.log

# ── Terraform (infra/) ─────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
# .terraform.lock.hcl is intentionally NOT ignored — pin provider versions

# ── Merge & patch artifacts ────────────────────────────────────────────────────
*.orig
*.rej

# ── Misc ───────────────────────────────────────────────────────────────────────
HELP.md
*.log
