# ── Environment & secrets ──────────────────────────────────────────────────────
# Covers .env.local, .env.prod, .env.*.local etc.
.env
.env.*
!.env.example

# Key material / keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local docker compose overrides
docker-compose.override.yml
compose.override.yml

# ── Java / Maven ───────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper jar (downloaded on demand)
.mvn/wrapper/maven-wrapper.jar

# ── Node / Angular ─────────────────────────────────────────────────────────────
node_modules/
dist/
out-tsc/
.angular/
.npm/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs ───────────────────────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
# Ignore all VS Code user settings, but keep shared project config
.vscode/*
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/settings.json
.history/
*.sw?

# Spring Tool Suite / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans / generic build output
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ── AI assistant local files ───────────────────────────────────────────────────
# Shared: CLAUDE.md, .claude/settings.json — personal: the files below
.claude/settings.local.json
CLAUDE.local.md

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test output ────────────────────────────────────────────────────────────────
coverage/

# ── JVM crash & heap dumps ─────────────────────────────────────────────────────
hs_err_pid*.log
replay_pid*.log
*.hprof

# ── Terraform (infra/) ─────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
*.auto.tfvars
override.tf
*_override.tf
# .terraform.lock.hcl is intentionally NOT ignored — pin provider versions

# ── Merge & patch artifacts ────────────────────────────────────────────────────
*.orig
*.rej

# ── Misc ───────────────────────────────────────────────────────────────────────
HELP.md
*.log

# ── Obsidian (docs vault) ──────────────────────────────────────────────────────
.obsidian/
